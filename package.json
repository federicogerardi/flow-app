{
  "name": "flow-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/domain",
    "packages/contracts",
    "packages/infra-db",
    "packages/copy"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/backend & npm run dev:worker --workspace=apps/backend & npm run dev --workspace=apps/frontend",
    "build": "tsc --build && npm run build --workspace=apps/frontend",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vitest": "^0.5.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
