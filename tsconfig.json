{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "composite": true
  },
  "references": [
    { "path": "packages/domain" },
    { "path": "packages/contracts" },
    { "path": "packages/infra-db" },
    { "path": "packages/copy" },
    { "path": "apps/backend" },
    { "path": "apps/frontend" }
  ],
  "exclude": ["node_modules", "dist", "coverage", "vitest.workspace.ts", "vitest.config.base.ts", "eslint.config.js"]
}
