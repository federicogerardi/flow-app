# apps/backend/.env.local.example
# Copia questo file in .env.local e sostituisci i valori
# .env.local ha priorità su .env

# Database (locale con docker compose up -d)
DATABASE_URL=postgresql://flow_app:flow_app@localhost:5432/flow_app

# Redis (locale con docker compose up -d)
REDIS_URL=redis://localhost:6379

# LLM Gateway (la tua API key OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Auth (genera stringhe random di 64 e 32 caratteri)
JWT_SECRET=change-me-to-a-random-64-char-string-for-local-dev
CSRF_SECRET=change-me-to-a-random-32-char

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
