# Database
DATABASE_URL=postgresql://flow_app:flow_app@localhost:5432/flow_app
PG_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# LLM Gateway
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=flow-app
LLM_DEFAULT_TIMEOUT_MS=60000

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string-for-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
CSRF_SECRET=change-me-to-a-random-32-char-string
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Dev Auth — must match seed user ID in DB
SEED_USER_ID=00000000-0000-0000-0000-000000000001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
SERPAPI_KEY=

# OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logging
LOG_LEVEL=debug
